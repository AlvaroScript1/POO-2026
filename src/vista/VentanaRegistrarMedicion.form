<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="vista.VentanaRegistrarMedicion">
  <grid id="27dc6" binding="panelPrincipal" layout-manager="BorderLayout" hgap="10" vgap="12">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="empty">
      <size top="10" left="10" bottom="10" right="10"/>
    </border>
    <children>
      <grid id="a1ade" layout-manager="GridBagLayout">
        <constraints border-constraint="North"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="c687" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              <gridbag top="4" left="4" bottom="4" right="4" weightx="0.0" weighty="0.0"/>
            </constraints>
            <properties>
              <text value="Estación:"/>
            </properties>
          </component>
          <component id="89a79" class="javax.swing.JComboBox" binding="comboEstaciones">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="2" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
              <gridbag top="4" left="4" bottom="4" right="4" weightx="1.0" weighty="0.0"/>
            </constraints>
            <properties/>
          </component>
          <component id="e87c7" class="javax.swing.JLabel">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              <gridbag top="4" left="4" bottom="4" right="4" weightx="0.0" weighty="0.0"/>
            </constraints>
            <properties>
              <text value="Sensor:"/>
            </properties>
          </component>
          <component id="c72ed" class="javax.swing.JComboBox" binding="comboSensores">
            <constraints>
              <grid row="1" column="1" row-span="1" col-span="2" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
              <gridbag top="4" left="4" bottom="4" right="4" weightx="1.0" weighty="0.0"/>
            </constraints>
            <properties/>
          </component>
          <component id="e3bbb" class="javax.swing.JLabel">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              <gridbag top="4" left="4" bottom="4" right="4" weightx="0.0" weighty="0.0"/>
            </constraints>
            <properties>
              <text value="Tipo de sensor:"/>
            </properties>
          </component>
          <component id="26762" class="javax.swing.JLabel" binding="etiquetaTipo">
            <constraints>
              <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              <gridbag top="4" left="4" bottom="4" right="4" weightx="0.0" weighty="0.0"/>
            </constraints>
            <properties>
              <text value="-"/>
            </properties>
          </component>
          <component id="94f26" class="javax.swing.JLabel">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              <gridbag top="4" left="4" bottom="4" right="4" weightx="0.0" weighty="0.0"/>
            </constraints>
            <properties>
              <text value="Fecha y hora:"/>
            </properties>
          </component>
          <component id="19157" class="javax.swing.JTextField" binding="campoFecha">
            <constraints>
              <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
              <gridbag top="4" left="4" bottom="4" right="4" weightx="1.0" weighty="0.0"/>
            </constraints>
            <properties/>
          </component>
          <component id="cd481" class="javax.swing.JLabel">
            <constraints>
              <grid row="3" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              <gridbag top="4" left="4" bottom="4" right="4" weightx="0.0" weighty="0.0"/>
            </constraints>
            <properties>
              <text value="dd/MM/yyyy HH:mm"/>
            </properties>
          </component>
          <component id="9482d" class="javax.swing.JLabel">
            <constraints>
              <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              <gridbag top="4" left="4" bottom="4" right="4" weightx="0.0" weighty="0.0"/>
            </constraints>
            <properties>
              <text value="Valor:"/>
            </properties>
          </component>
          <component id="23b97" class="javax.swing.JTextField" binding="campoValor">
            <constraints>
              <grid row="4" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
              <gridbag top="4" left="4" bottom="4" right="4" weightx="1.0" weighty="0.0"/>
            </constraints>
            <properties/>
          </component>
          <component id="7fd90" class="javax.swing.JLabel" binding="etiquetaUnidad">
            <constraints>
              <grid row="4" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              <gridbag top="4" left="4" bottom="4" right="4" weightx="0.0" weighty="0.0"/>
            </constraints>
            <properties>
              <text value=""/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="b4b33" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="2">
        <constraints border-constraint="South"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="27366" class="javax.swing.JButton" binding="botonRegistrar">
            <constraints/>
            <properties>
              <text value="Registrar"/>
            </properties>
          </component>
          <component id="1ab81" class="javax.swing.JButton" binding="botonCancelar">
            <constraints/>
            <properties>
              <text value="Cancelar"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
