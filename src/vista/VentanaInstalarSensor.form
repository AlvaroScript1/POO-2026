<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="vista.VentanaInstalarSensor">
  <grid id="27dc6" binding="panelPrincipal" layout-manager="BorderLayout" hgap="10" vgap="12">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="8dcb6" layout-manager="GridBagLayout">
        <constraints border-constraint="North"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="2accb" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              <gridbag weightx="0.0" weighty="0.0"/>
            </constraints>
            <properties>
              <text value="Estación:"/>
            </properties>
          </component>
          <component id="2b4e2" class="javax.swing.JComboBox" binding="comboEstaciones">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
              <gridbag weightx="1.0" weighty="0.0"/>
            </constraints>
            <properties>
              <model/>
            </properties>
          </component>
          <component id="1ba91" class="javax.swing.JLabel">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              <gridbag weightx="0.0" weighty="0.0"/>
            </constraints>
            <properties>
              <text value="Código del sensor:"/>
            </properties>
          </component>
          <component id="fabe7" class="javax.swing.JLabel">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              <gridbag weightx="0.0" weighty="0.0"/>
            </constraints>
            <properties>
              <text value="Marca:"/>
            </properties>
          </component>
          <component id="e2dfd" class="javax.swing.JLabel">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              <gridbag weightx="0.0" weighty="0.0"/>
            </constraints>
            <properties>
              <text value="Modelo:"/>
            </properties>
          </component>
          <component id="42395" class="javax.swing.JTextField" binding="codigo">
            <constraints>
              <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
              <gridbag weightx="1.0" weighty="0.0"/>
            </constraints>
            <properties/>
          </component>
          <component id="8d6f2" class="javax.swing.JTextField" binding="marca">
            <constraints>
              <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
              <gridbag weightx="1.0" weighty="0.0"/>
            </constraints>
            <properties/>
          </component>
          <component id="2f6f3" class="javax.swing.JTextField" binding="modelo">
            <constraints>
              <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="150" height="-1"/>
              </grid>
              <gridbag weightx="1.0" weighty="0.0"/>
            </constraints>
            <properties/>
          </component>
        </children>
      </grid>
      <grid id="83870" binding="tipos" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="etched" title="Tipo de sensor">
          <font/>
        </border>
        <children/>
      </grid>
      <grid id="a4c20" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="2">
        <constraints border-constraint="South"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="8f39f" class="javax.swing.JButton" binding="botonInstalar">
            <constraints/>
            <properties>
              <text value="Instalar"/>
            </properties>
          </component>
          <component id="929ac" class="javax.swing.JButton" binding="botonCancelar">
            <constraints/>
            <properties>
              <text value="Cancelar"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
