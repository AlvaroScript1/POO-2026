<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="vista.VentanaCambiarEstadoSensor">
  <grid id="27dc6" binding="panelPrincipal" layout-manager="BorderLayout" hgap="10" vgap="12">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="empty">
      <size top="10" left="10" bottom="10" right="10"/>
    </border>
    <children>
      <grid id="9b224" layout-manager="GridBagLayout">
        <constraints border-constraint="North"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="44af3" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              <gridbag weightx="0.0" weighty="0.0"/>
            </constraints>
            <properties>
              <text value="Estación:"/>
            </properties>
          </component>
          <component id="910d" class="javax.swing.JLabel">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              <gridbag weightx="0.0" weighty="0.0"/>
            </constraints>
            <properties>
              <text value="Estado actual:"/>
            </properties>
          </component>
          <component id="5f9a3" class="javax.swing.JLabel">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              <gridbag weightx="0.0" weighty="1.0"/>
            </constraints>
            <properties>
              <text value="Nuevo estado:"/>
            </properties>
          </component>
          <component id="4038" class="javax.swing.JComboBox" binding="comboEstaciones">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
              <gridbag weightx="1.0" weighty="0.0"/>
            </constraints>
            <properties/>
          </component>
          <component id="a8cea" class="javax.swing.JComboBox" binding="comboSensores">
            <constraints>
              <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="2" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
              <gridbag weightx="1.0" weighty="0.0"/>
            </constraints>
            <properties/>
          </component>
          <component id="a3943" class="javax.swing.JLabel">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              <gridbag weightx="0.0" weighty="0.0"/>
            </constraints>
            <properties>
              <text value="Sensor:"/>
            </properties>
          </component>
          <component id="ab1fe" class="javax.swing.JLabel" binding="etiquetaEstadoActual">
            <constraints>
              <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
              <gridbag weightx="1.0" weighty="0.0"/>
            </constraints>
            <properties>
              <text value="&quot;-&quot;"/>
            </properties>
          </component>
          <grid id="20d5d" binding="panelEstados" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="0">
            <constraints>
              <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
              <gridbag weightx="1.0" weighty="1.0"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children/>
          </grid>
        </children>
      </grid>
      <grid id="5c622" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="2">
        <constraints border-constraint="South"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="66a48" class="javax.swing.JButton" binding="botonCambiarEstado">
            <constraints/>
            <properties>
              <text value="Cambiar estado"/>
            </properties>
          </component>
          <component id="7b2d7" class="javax.swing.JButton" binding="botonCancelar">
            <constraints/>
            <properties>
              <text value="Cancelar"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
